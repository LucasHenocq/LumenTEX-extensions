{
  "id": "typst",
  "name": "Typst",
  "version": "1.0.1",
  "author": "Lumen TeX",
  "description": "Écrivez en Typst : coloration, autocomplétion, compilation et erreurs dans l'éditeur. Typst (le programme officiel) se télécharge à la première compilation.",
  "lumen": "1.5.2",
  "main": "main.js",
  "node": "node.js",
  "permissions": {
    "network": [
      "github.com"
    ]
  },
  "languages": [
    {
      "id": "typst",
      "name": "Typst",
      "extensions": [
        ".typ"
      ],
      "icon": "fichier-typ.svg"
    }
  ],
  "settings": [
    {
      "id": "chemin",
      "label": "Programme Typst",
      "type": "text",
      "default": "",
      "description": "Vide : celui téléchargé par l'extension. Sinon, le chemin d'un typst déjà installé."
    }
  ],
  "templates": [
    {
      "name": "Document Typst",
      "description": "Un document écrit en Typst",
      "folder": "modele"
    }
  ],
  "symbols": [
    {
      "name": "Grec",
      "language": "typst",
      "items": [
        "α alpha",
        "β beta",
        "γ gamma",
        "δ delta",
        "ε epsilon",
        "ζ zeta",
        "η eta",
        "θ theta",
        "ι iota",
        "κ kappa",
        "λ lambda",
        "μ mu",
        "ν nu",
        "ξ xi",
        "π pi",
        "ρ rho",
        "σ sigma",
        "τ tau",
        "υ upsilon",
        "φ phi",
        "χ chi",
        "ψ psi",
        "ω omega",
        "Γ Gamma",
        "Δ Delta",
        "Θ Theta",
        "Λ Lambda",
        "Ξ Xi",
        "Π Pi",
        "Σ Sigma",
        "Φ Phi",
        "Ψ Psi",
        "Ω Omega"
      ]
    },
    {
      "name": "Opérateurs",
      "language": "typst",
      "items": [
        "± plus.minus",
        "∓ minus.plus",
        "× times",
        "÷ div",
        "· dot.c",
        "∘ compose",
        "⊕ plus.o",
        "⊗ times.o",
        "∩ inter",
        "∪ union",
        "∧ and",
        "∨ or",
        "∖ without",
        "∑ sum",
        "∏ product",
        "∫ integral",
        "∬ integral.double",
        "∮ integral.cont",
        "∂ partial",
        "∇ nabla",
        "∞ infinity"
      ]
    },
    {
      "name": "Relations",
      "language": "typst",
      "items": [
        "≠ eq.not",
        "≤ lt.eq",
        "≥ gt.eq",
        "≪ lt.double",
        "≫ gt.double",
        "≈ approx",
        "≡ equiv",
        "∼ tilde.op",
        "≃ tilde.eq",
        "≅ tilde.equiv",
        "∝ prop",
        "∈ in",
        "∉ in.not",
        "∋ in.rev",
        "⊂ subset",
        "⊃ supset",
        "⊆ subset.eq",
        "⊇ supset.eq",
        "⟂ perp",
        "∥ parallel",
        "∣ divides"
      ]
    },
    {
      "name": "Flèches",
      "language": "typst",
      "items": [
        "→ arrow.r",
        "← arrow.l",
        "↔ arrow.l.r",
        "⇒ arrow.r.double",
        "⇐ arrow.l.double",
        "⇔ arrow.l.r.double",
        "↦ arrow.r.bar",
        "⟶ arrow.r.long",
        "⟹ arrow.r.double.long",
        "↑ arrow.t",
        "↓ arrow.b",
        "↗ arrow.tr",
        "↘ arrow.br",
        "↪ arrow.r.hook",
        "⇀ harpoon.rt"
      ]
    },
    {
      "name": "Ensembles et logique",
      "language": "typst",
      "items": [
        "ℕ NN",
        "ℤ ZZ",
        "ℚ QQ",
        "ℝ RR",
        "ℂ CC",
        "∅ emptyset",
        "∀ forall",
        "∃ exists",
        "∄ exists.not",
        "¬ not",
        "⊤ top",
        "⊥ bot",
        "∴ therefore",
        "∵ because",
        "ℓ ell",
        "ħ planck",
        "′ prime",
        "… dots.h",
        "⋯ dots.h.c",
        "⋮ dots.v",
        "⋱ dots.down"
      ]
    }
  ]
}
